# Supabase 연결 정보
# Supabase 대시보드 > Project Settings > API Keys 에서 값을 복사하세요.
# 이 파일을 .env.local 로 복사한 뒤 값을 채우면 어드민/라이브 편집이 활성화됩니다.
# (값이 비어 있으면 사이트는 기본 콘텐츠로 동작하고 어드민은 안내 화면을 표시합니다.)

NEXT_PUBLIC_SUPABASE_URL=https://opxqydoebiquhhmcnhmq.supabase.co

# 새 publishable 키 (sb_publishable_... 로 시작) — 구 anon 키 대체
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 사이트 공개 URL (커스텀 도메인 확정 후 Vercel 환경변수에도 동일하게 설정)
# 미설정 시 Vercel 배포 URL(VERCEL_URL), 로컬에서는 http://localhost:3000 을 사용합니다.
# canonical URL / sitemap / OG 태그 / JSON-LD 절대경로에 쓰입니다.
NEXT_PUBLIC_SITE_URL=

# Contact 문의 이메일 알림 (Resend)
# Vercel Marketplace 연결 시 RESEND_API_KEY와 RESEND_EMAIL_DOMAIN이 자동 생성됩니다.
# CONTACT_FROM_EMAIL은 발신 이름/주소를 직접 지정하고 싶을 때만 설정하세요.
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=brandinsighter.kr
# CONTACT_FROM_EMAIL="Brand Insighter <contact@brandinsighter.kr>"
# 쉼표로 여러 수신자를 지정할 수 있습니다.
CONTACT_NOTIFICATION_TO=saintbrand@naver.com
